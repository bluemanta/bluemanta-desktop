{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@bluemanta/server/api-types": ["../server/src/api-types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
