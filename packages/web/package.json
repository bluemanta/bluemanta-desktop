{
  "name": "@bluemanta/web",
  "version": "0.0.0",
  "private": true,
  "description": "bluemanta 工作台网页（灵感台）：由本地服务托管，只经 /api/v1 访问数据",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "dev": "node scripts/dev.ts",
    "seed": "node scripts/seed-cli.ts",
    "walkthrough": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@bluemanta/core": "file:../core",
    "@bluemanta/server": "file:../server",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
