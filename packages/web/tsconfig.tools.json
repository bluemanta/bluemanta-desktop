{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@bluemanta/core": ["../core/src/index.ts"],
      "@bluemanta/server": ["../server/src/index.ts"],
      "@bluemanta/server/api-types": ["../server/src/api-types.ts"],
      "@bluemanta/cli/data-dir": ["../cli/src/data-dir.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
