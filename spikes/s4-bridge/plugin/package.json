{
  "name": "@bluemanta/spike-s4-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "S4 技术验证：网页经消息桥请 dsh 在当前对话输入框插入引用",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
