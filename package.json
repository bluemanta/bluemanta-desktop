{
  "name": "bluemanta-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/dsh-plugin",
    "packages/importer",
    "packages/mcp",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "check:pr": "node scripts/check-pr-delivery.mjs",
    "test:pr": "node --test scripts/check-pr-delivery.test.mjs",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test:pr && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:dsh": "node packages/dsh-plugin/scripts/dev-dsh.mjs",
    "import:workbench": "node packages/importer/dist/cli.js",
    "idea": "node packages/cli/dist/idea.js",
    "server": "node packages/server/dist/cli.js start",
    "service": "node packages/server/dist/cli.js service",
    "dev:web": "npm run build -w @bluemanta/core -w @bluemanta/cli -w @bluemanta/server && npm run dev -w @bluemanta/web",
    "walkthrough": "npm run walkthrough -w @bluemanta/web"
  }
}
